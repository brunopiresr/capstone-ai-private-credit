# Live PydanticAI generation; entry points load .env explicitly.
OPENAI_API_KEY=
# Streamlit follow-ups only; notebooks select MODEL in their configuration cells.
LLM_MODEL=
# Optional: suppress PydanticAI's first-run setup banner.
PYDANTIC_AI_NO_BANNER=1
# SEC downloader reads the environment; notebooks also load the root .env.
SEC_USER_AGENT=
# Optional isolated Evidently runner (loads .env only with --env-file).
EVIDENTLY_JUDGE_MODEL=gpt-4o-mini

# Logfire: use the existing project's send credential; export is optional.
LOGFIRE_TOKEN=
LOGFIRE_BASE_URL=https://logfire-eu.pydantic.dev
LOGFIRE_SERVICE_NAME=credit-monitoring
LOGFIRE_ENVIRONMENT=development
LOGFIRE_SEND_TO_LOGFIRE=if-token-present
LOGFIRE_CAPTURE_CONTENT=true
LOGFIRE_MIN_LEVEL=info

# Reserved scaffold names: no active global settings loader consumes these.
# Logging is configured with configure_logging() or the assessment CLI --log-level.
APP_ENV=
LOG_LEVEL=
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
DATABASE_URL=
VECTOR_STORE_PATH=
DATA_ROOT=
